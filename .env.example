# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Game Configuration
# Default playlist ID to use when creating a room
# Available playlists: test-playlist, kpop-2000s, kpop-2010s, pop-classics, latest-chart
DEFAULT_PLAYLIST_ID=test-playlist

# Auth Configuration
# Strong random secret used to sign JWTs (REQUIRED in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here
# Token lifetime (e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=7d
# bcrypt hashing cost (higher = slower/safer)
BCRYPT_ROUNDS=10
# Auth cookie lifetime in days (keep in sync with JWT_EXPIRES_IN; default 7)
AUTH_COOKIE_MAX_AGE_DAYS=7

# Database Configuration
# SQLite database file path (optional, defaults to packages/server/src/data/listenup.db)
# DB_PATH=./packages/server/src/data/listenup.db
