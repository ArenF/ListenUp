# 서버 URL (optional — 개발 중에는 Vite 프록시를 쓰므로 비워둔다)
# VITE_SERVER_URL=https://api.example.com

# Firebase 웹 앱 설정
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig 값 (공개돼도 되는 값)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 로컬 에뮬레이터(firebase emulators:start) 사용 시 true
# VITE_USE_FIREBASE_EMULATORS=true
